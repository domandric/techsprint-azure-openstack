#cloud-config
ssh_pwauth: false
disable_root: true
users:
  - name: ${developer_slug}
    groups: [wheel]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    ssh_authorized_keys:
      - ${jsonencode(public_key)}
      - ${jsonencode(lead_public_key)}
write_files:
  - path: /etc/my.cnf.d/techsprint.cnf
    permissions: '0644'
    content: |
      [mysqld]
      bind-address=0.0.0.0
      character-set-server=utf8mb4
      collation-server=utf8mb4_unicode_ci
      datadir=/srv/mysql
      socket=/var/lib/mysql/mysql.sock
      [client]
      default-character-set=utf8mb4
      socket=/var/lib/mysql/mysql.sock
  - path: /etc/yum.repos.d/mariadb.repo
    permissions: '0644'
    content: |
      [mariadb]
      name=MariaDB 10.11 for Rocky Linux 8 - $basearch
      baseurl=https://rpm.mariadb.org/10.11/rhel/8/$basearch
      enabled=1
      gpgcheck=1
      gpgkey=https://rpm.mariadb.org/RPM-GPG-KEY-MariaDB
      module_hotfixes=1
  - path: /usr/local/sbin/techsprint-db-bootstrap
    permissions: '0700'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      required_packages=(MariaDB-server MariaDB-client MariaDB-shared firewalld python3 xfsprogs policycoreutils policycoreutils-python-utils)
      packages_installed=false
      package_deadline=$((SECONDS + 900))
      while (( SECONDS < package_deadline )); do
        if timeout --signal=TERM --kill-after=10s 120s dnf --setopt=timeout=15 --setopt=retries=2 module disable -y mariadb && timeout --signal=TERM --kill-after=10s 120s dnf install -y --setopt=timeout=15 --setopt=retries=2 "$${required_packages[@]}"; then
          packages_installed=true
          break
        fi
        sleep 5
      done
      [[ "$${packages_installed}" == true ]] || { printf 'Required database packages did not install within the retry budget\n' >&2; exit 1; }
      if grep -q '^SELINUX=' /etc/selinux/config; then sed -i 's/^SELINUX=.*/SELINUX=enforcing/' /etc/selinux/config; else printf '\nSELINUX=enforcing\n' >> /etc/selinux/config; fi
      setenforce 1
      [[ "$(getenforce)" == Enforcing ]] || { printf 'SELinux is not enforcing\n' >&2; exit 1; }
      configure_firewalld() (
        set -euo pipefail
        restore_selinux() {
          setenforce 1
        }
        trap restore_selinux EXIT
        systemctl enable --now firewalld
        setenforce 0
        timeout --signal=TERM --kill-after=5s 30s firewall-cmd --permanent --add-service=mysql
        timeout --signal=TERM --kill-after=5s 30s firewall-cmd --permanent --add-service=ssh
        timeout --signal=TERM --kill-after=5s 30s firewall-cmd --permanent --add-port=9200/tcp
        timeout --signal=TERM --kill-after=5s 30s firewall-cmd --reload
        timeout --signal=TERM --kill-after=5s 30s systemctl restart firewalld
        setenforce 1
        trap - EXIT
      )
      configure_firewalld
      [[ "$(getenforce)" == Enforcing ]] || { printf 'SELinux was not restored to enforcing after firewalld configuration\n' >&2; exit 1; }
      installed_mariadb_version=$(rpm -q --qf '%%{VERSION}\n' MariaDB-server)
      lowest_supported_version=$(printf '10.11\n%s\n' "$${installed_mariadb_version}" | sort -V | sed -n '1p')
      [[ "$${lowest_supported_version}" == 10.11 ]] || { printf 'MariaDB 10.11 or newer is required; installed %s\n' "$${installed_mariadb_version}" >&2; exit 1; }
      systemctl stop mariadb
      socket_dir=/var/lib/mysql
      socket_path=$${socket_dir}/mysql.sock
      install -d -o mysql -g mysql -m 0755 "$${socket_dir}"
      restorecon -RF "$${socket_dir}"
      if [[ -e "$${socket_path}" || -L "$${socket_path}" ]]; then
        [[ -S "$${socket_path}" ]] || { printf 'Refusing to remove non-socket MariaDB path: %s\n' "$${socket_path}" >&2; exit 1; }
        rm -f -- "$${socket_path}"
      fi
      volume="${volume_device}"
      for attempt in $(seq 1 60); do
        if [[ -b "$${volume}" ]]; then break; fi
        sleep 5
      done
      [[ -b "$${volume}" ]] || { printf 'Required Cinder data disk is missing: %s\n' "$${volume}" >&2; exit 1; }
      [[ $(lsblk -ndo TYPE "$${volume}") == disk ]] || { printf 'Expected a whole non-root Cinder disk: %s\n' "$${volume}" >&2; exit 1; }
      root_source=$(findmnt -no SOURCE /)
      volume_real=$(readlink -f "$${volume}")
      root_real=$(readlink -f "$${root_source}" 2>/dev/null || true)
      [[ "$${volume_real}" != "$${root_real}" && "$${volume}" != /dev/vda ]] || { printf 'Refusing to use the root disk for MariaDB\n' >&2; exit 1; }
      volume_uuid=$(blkid -s UUID -o value "$${volume}" 2>/dev/null || true)
      if [[ -z "$${volume_uuid}" ]]; then
        mkfs.xfs -f "$${volume}"
        volume_uuid=$(blkid -s UUID -o value "$${volume}")
      fi
      [[ -n "$${volume_uuid}" ]] || { printf 'Cinder data disk has no filesystem UUID\n' >&2; exit 1; }
      mkdir -p /srv/mysql
      sed -i '\|[[:space:]]/srv/mysql[[:space:]]|d' /etc/fstab
      printf 'UUID=%s /srv/mysql xfs defaults 0 2\n' "$${volume_uuid}" >> /etc/fstab
      mountpoint -q /srv/mysql || mount /srv/mysql || { printf 'Required Cinder MariaDB mount is absent\n' >&2; exit 1; }
      [[ $(findmnt -no UUID /srv/mysql) == "$${volume_uuid}" ]] || exit 1
      [[ -e /srv/mysql/mysql ]] || mariadb-install-db --user=mysql --datadir=/srv/mysql
      semanage fcontext -a -t mysqld_db_t '/srv/mysql(/.*)?' 2>/dev/null || semanage fcontext -m -t mysqld_db_t '/srv/mysql(/.*)?'
      chown -R mysql:mysql /srv/mysql
      restorecon -RF /srv/mysql
      systemctl enable --now mariadb
      ready=false
      for attempt in $(seq 1 60); do
        if mariadb-admin --protocol=socket -uroot ping --silent; then ready=true; break; fi
        sleep 2
      done
      [[ "$${ready}" == true ]] || { printf 'MariaDB did not become ready\n' >&2; exit 1; }
      umask 077
      db_password_file=$(mktemp /run/techsprint-db-password.XXXXXX)
      trap 'rm -f "$${db_password_file}"' EXIT
      printf '%s' '${db_password_b64}' | base64 --decode > "$${db_password_file}"
      db_password_hex=$(od -An -tx1 -v "$${db_password_file}" | tr -d '[:space:]')
      [[ -n "$${db_password_hex}" ]] || { printf 'Decoded database password is empty\n' >&2; exit 1; }
      mariadb -uroot <<SQL
      SET @db_name = '${db_name}';
      SET @sql = CONCAT('CREATE DATABASE IF NOT EXISTS ', CHAR(96), @db_name, CHAR(96), ' CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci');
      PREPARE create_database FROM @sql;
      EXECUTE create_database;
      DEALLOCATE PREPARE create_database;
      SET @password_hex = '$${db_password_hex}';
      SET @password = CONVERT(UNHEX(@password_hex) USING utf8mb4);
      SET @db_user = '${db_user}';
      SET @db_host = '${subnet_prefix}.%';
      SET @sql = CONCAT('CREATE USER IF NOT EXISTS ', QUOTE(@db_user), '@', QUOTE(@db_host), ' IDENTIFIED BY ', QUOTE(@password));
      PREPARE create_user FROM @sql;
      EXECUTE create_user;
      DEALLOCATE PREPARE create_user;
      SET @sql = CONCAT('ALTER USER ', QUOTE(@db_user), '@', QUOTE(@db_host), ' IDENTIFIED BY ', QUOTE(@password));
      PREPARE alter_user FROM @sql;
      EXECUTE alter_user;
      DEALLOCATE PREPARE alter_user;
      SET @sql = CONCAT('GRANT ALL ON ', CHAR(96), '${db_name}', CHAR(96), '.* TO ', QUOTE(@db_user), '@', QUOTE(@db_host));
      PREPARE grant_user FROM @sql;
      EXECUTE grant_user;
      DEALLOCATE PREPARE grant_user;
      FLUSH PRIVILEGES;
      SQL
      rm -f "$${db_password_file}"
      unset db_password_hex
      mkdir -p /var/www/health
      printf 'healthy ${developer_slug}\n' > /var/www/health/index.html
  - path: /etc/systemd/system/techsprint-db-health.service
    permissions: '0644'
    content: |
      [Unit]
      After=network-online.target
      [Service]
      ExecStart=/usr/bin/python3 -m http.server 9200 --directory /var/www/health
      Restart=always
      [Install]
      WantedBy=multi-user.target
runcmd:
  - [bash, /usr/local/sbin/techsprint-db-bootstrap]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, techsprint-db-health.service]
final_message: TECHSPRINT_DB_READY_${developer_slug}
